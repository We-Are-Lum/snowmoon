# Milestone 1
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the client, never commit.
SUPABASE_SERVICE_ROLE_KEY=
# Public URL of the deployed app, e.g. https://snowmoon.example.com (used for Quick Auth domain and the manifest)
NEXT_PUBLIC_URL=

# Farcaster manifest account association (generate in the Farcaster developer tools for NEXT_PUBLIC_URL's domain)
FARCASTER_HEADER=
FARCASTER_PAYLOAD=
FARCASTER_SIGNATURE=
